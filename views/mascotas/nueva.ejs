<h1><%= titulo %></h1>

<% if (error) { %>
  <p class="error" role="alert"><%= error %></p>
<% } %>

<form action="/mascotas" method="post">

  <div class="campo">
    <label for="nombre">Nombre</label>
    <input
      type="text"
      id="nombre"
      name="nombre"
      value="<%= valores?.nombre || "" %>"
      required
    >
  </div>

  <div class="campo">
    <label for="especie">Especie</label>
    <input
      type="text"
      id="especie"
      name="especie"
      value="<%= valores?.especie || "" %>"
      required
    >
  </div>

  <div class="campo">
    <label for="edad">Edad</label>
    <input
      type="number"
      id="edad"
      name="edad"
      min="0"
      value="<%= valores?.edad ?? "" %>"
      required
    >
  </div>

  <div class="campo">
    <label for="estado">Estado</label>
    <select id="estado" name="estado" required>
      <option value="En adopción" <%= valores?.estado === "En adopción" ? "selected" : "" %>>
        En adopción
      </option>
      <option value="Reservada" <%= valores?.estado === "Reservada" ? "selected" : "" %>>
        Reservada
      </option>
      <option value="Adoptada" <%= valores?.estado === "Adoptada" ? "selected" : "" %>>
        Adoptada
      </option>
    </select>
  </div>

  <div class="campo">
    <label for="descripcion">Descripción</label>
    <textarea
      id="descripcion"
      name="descripcion"
      rows="5"
      required
    ><%= valores?.descripcion || "" %></textarea>
  </div>

  <button class="boton" type="submit">Registrar mascota</button>

</form>